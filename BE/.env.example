PORT=5000
MONGO_URI=mongodb://localhost:27017/wdp301
# Comma-separated DNS servers used to resolve MongoDB Atlas mongodb+srv URIs.
MONGO_DNS_SERVERS=1.1.1.1,8.8.8.8
CLIENT_URL=http://localhost:5173
# Public address in tenant links built by the backend (debt reminders); defaults to CLIENT_URL
PUBLIC_APP_URL=
NODE_ENV=development
# Production cross-site: COOKIE_SAME_SITE=none (HTTPS required)
COOKIE_SAME_SITE=lax
# Deployed with FE and API on different domains (Vercel + Render): COOKIE_SAME_SITE=none (Secure is then set automatically, HTTPS only)
# Behind a hosting proxy (Render, Railway): set TRUST_PROXY=1
TRUST_PROXY=

# CLIENT_URL may list several origins, comma-separated (first one = default links).
# Allow Vercel preview URLs of your own team only, e.g. -yourteam-projects.vercel.app (empty = none)
VERCEL_PREVIEW_SUFFIX=

# Audit log retention in days (0 = keep forever). Finance entries (invoices, payments, bank,
# deposits, settlements, SaaS billing, pricing, repair costs) are kept longer.
AUDIT_RETENTION_DAYS=365
AUDIT_FINANCE_RETENTION_DAYS=3650

# Generate a unique secret (minimum 32 characters):
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# SePay Payment Gateway
# apikey: Authorization: Apikey <SEPAY_API_KEY>
# hmac: X-SePay-Timestamp + X-SePay-Signature, signed over timestamp.raw-body
SEPAY_AUTH_MODE=apikey
SEPAY_API_KEY=
SEPAY_WEBHOOK_SECRET=

# payOS payment gateway: the platform collects SaaS plan fees from landlords.
# Keys from my.payos.vn > kênh thanh toán. Webhook URL to set there:
# https://<BE domain>/api/v1/plans/payments/ipn (verified with the checksum key).
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Where payOS returns the landlord (adds ?payment=success|cancel&invoice=...). Default: CLIENT_URL/plans
PAYOS_RETURN_URL=http://localhost:5173/plans
# PAYOS_API_URL=https://api-merchant.payos.vn

# SePay Bank Hub: each landlord links their own bank account (hosted link iframe).
# sandbox -> https://bankhub-api-sandbox.sepay.vn, production -> https://bankhub-api.sepay.vn
# Test bank accounts are entered by the landlord inside the sandbox iframe; nothing is preconfigured.
SEPAY_BANKHUB_ENV=sandbox
SEPAY_BANKHUB_CLIENT_ID=
SEPAY_BANKHUB_CLIENT_SECRET=
# Balance-change IPN: SePay sends "Authorization: Apikey <key>" to POST /api/v1/bank-hub/ipn
SEPAY_BANKHUB_IPN_API_KEY=
# Link/unlink events: register POST /api/v1/bank-hub/events with auth_type SECRET_KEY (header X-Secret-Key)
SEPAY_BANKHUB_WEBHOOK_SECRET=
# Optional, HTTPS in production: where the iframe redirects after linking
SEPAY_BANKHUB_REDIRECT_URI=

# No accounts or demo data are created automatically: the SUPER_ADMIN account must already
# exist in the database. Landlords self-register; managers/tenants get temporary passwords
# from their landlord. See API.md (mục Auth).

# Incident triage with TypeSafe Jev (category + priority). Empty key = feature off.
# Incident title and description are sent to api.typesafe.ai.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Tenant accounts are locked when no contract is left (running, or ended less than N days ago)
# and nothing is owed. A new contract with the same CCCD reopens the account with the old password.
TENANT_AUTO_LOCK=true
TENANT_LOCK_AFTER_DAYS=30

# Email (debt reminders). Emails show the landlord + branch as sender name and Reply-To is the
# landlord's own email, so tenants reply to the landlord directly.
# EMAIL_PROVIDER=smtp|brevo; empty = picked from whichever keys below are set.
EMAIL_PROVIDER=
# smtp (local): Gmail address + App Password (Google account > Security > 2-Step Verification >
# App passwords). Render free instances block SMTP ports: use brevo there.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# brevo (HTTP API, works on Render): brevo.com > SMTP & API > API Keys (key starts with xkeysib-).
# Verify EMAIL_FROM_ADDRESS under Senders, Domains & Dedicated IPs > Senders (a Gmail address is
# fine: Brevo emails a confirmation link, no domain needed).
BREVO_API_KEY=
# Sender address (required for brevo; for smtp defaults to SMTP_USER).
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=DOMUS
# Daily automatic debt reminder emails (8:00-20:00 VN time, max one per invoice per day).
DEBT_REMINDER_AUTO=true
