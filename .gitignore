# ==========================================
# Comprehensive .gitignore for Full-Stack Project
# Covers both Root, Backend (BE), and Frontend (FE)
# ==========================================

# ------------------------------------------
# Environment Variables & Secrets (CRITICAL)
# ------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
id_rsa*
*.pfx
secrets.*

# ------------------------------------------
# Operating System & IDE Files
# ------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (IntelliJ, WebStorm, PyCharm, etc.)
.idea/
*.iws
*.iml
*.ipr
out/

# ------------------------------------------
# Node.js / Frontend (React, Vue, Angular, Next, Vite, etc.)
# ------------------------------------------
node_modules/
jspm_packages/
.npm
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp
.pnp.js
.pnpm-store/

# Build outputs
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.output/
.svelte-kit/
.parcel-cache/
.turbo/

# ------------------------------------------
# Logs & Databases / Runtime Data
# ------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.sqlite
*.sqlite3
*.db

# ------------------------------------------
# Testing & Coverage
# ------------------------------------------
coverage/
.nyc_output/
cypress/videos/
cypress/screenshots/
.playwright/
test-results/

# ------------------------------------------
# Backend: Python (Django, FastAPI, Flask, etc.)
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.mypy_cache/

# ------------------------------------------
# Backend: Java (Spring Boot, Maven, Gradle)
# ------------------------------------------
*.class
target/
.mvn/wrapper/maven-wrapper.jar
.gradle/
build/

# ------------------------------------------
# Backend: .NET / C#
# ------------------------------------------
bin/
obj/
*.suo
*.user
*.userosscache
*.sln.docstates

# ------------------------------------------
# Backend: PHP (Laravel, etc.)
# ------------------------------------------
vendor/

# ------------------------------------------
# Temporary & Cache files
# ------------------------------------------
tmp/
temp/
.cache/
.eslintcache
.prettiercache
.stylelintcache
